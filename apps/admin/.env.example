# Copiar a .env.local (no se commitea) y completar con los datos del proyecto Supabase.
# Solo valores públicos: la anon key es segura en el navegador porque RLS protege los datos.
# NUNCA poner aquí la service role key ni secretos de Edge Functions.
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=
